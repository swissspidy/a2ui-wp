{
	"name": "a2ui-wp",
	"version": "0.1.0",
	"description": "Renders agent-generated A2UI surfaces inside wp-admin with the WordPress component library.",
	"author": "Pascal Birchler",
	"license": "Apache-2.0 OR GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"wordpress-plugin",
		"a2ui",
		"agents",
		"components"
	],
	"homepage": "https://github.com/swissspidy/a2ui-wp",
	"repository": {
		"type": "git",
		"url": "https://github.com/swissspidy/a2ui-wp.git"
	},
	"bugs": {
		"url": "https://github.com/swissspidy/a2ui-wp/issues"
	},
	"engines": {
		"node": ">=22"
	},
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"devDependencies": {
		"@a2ui/web_core": "^0.14.0",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@playwright/test": "^1.64.1",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@wordpress/api-fetch": "^8.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/dom-ready": "^5.0.0",
		"@wordpress/e2e-test-utils-playwright": "^3.1.0",
		"@wordpress/element": "^10.0.0",
		"@wordpress/env": "^12.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/icons": "^19.0.0",
		"@wordpress/scripts": "^37.0.0",
		"jsdom": "^30.1.3",
		"publint": "^0.3.25",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	},
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:js:fix": "wp-scripts lint-js --fix",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"typecheck": "tsc --noEmit",
		"wp-env": "wp-env",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "wp-scripts test-playwright --config tests/e2e/playwright.config.ts",
		"build:package": "npm run build --workspace @swissspidy/a2ui-wp",
		"lint:publish": "publint --strict packages/a2ui-wp",
		"changeset": "changeset",
		"version-packages": "changeset version && npm install --package-lock-only"
	}
}
