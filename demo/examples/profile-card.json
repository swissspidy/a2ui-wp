{
	"name": "Profile card",
	"description": "Card, Row, Column, Image, Icon, Text variants, Divider and a Button that sends a server event with a bound context value.",
	"messages": [
		{ "version": "v0.9.1", "createSurface": { "surfaceId": "profile", "catalogId": "https://a2ui.org/specification/v0_9_1/catalogs/basic/catalog.json", "theme": { "primaryColor": "#7f54b3" } } },
		{ "version": "v0.9.1", "updateComponents": { "surfaceId": "profile", "components": [
			{ "id": "root", "component": "Card", "child": "layout" },
			{ "id": "layout", "component": "Column", "children": [ "header", "divider", "bio", "actions" ] },
			{ "id": "header", "component": "Row", "align": "center", "children": [ "avatar", "names" ] },
			{ "id": "avatar", "component": "Image", "variant": "avatar", "fit": "cover", "url": { "path": "/user/avatar" }, "description": "Avatar" },
			{ "id": "names", "component": "Column", "children": [ "name", "role" ] },
			{ "id": "name", "component": "Text", "variant": "h3", "text": { "call": "formatString", "args": { "value": "${/user/firstName} ${/user/lastName}" }, "returnType": "string" } },
			{ "id": "role", "component": "Text", "variant": "caption", "text": { "path": "/user/role" } },
			{ "id": "divider", "component": "Divider" },
			{ "id": "bio", "component": "Row", "align": "start", "children": [ "info-icon", "bio-text" ] },
			{ "id": "info-icon", "component": "Icon", "name": "info" },
			{ "id": "bio-text", "component": "Text", "text": { "path": "/user/bio" } },
			{ "id": "actions", "component": "Row", "justify": "end", "children": [ "site-button", "follow-button" ] },
			{ "id": "site-button-label", "component": "Text", "text": "Visit site" },
			{ "id": "site-button", "component": "Button", "variant": "borderless", "child": "site-button-label", "action": { "functionCall": { "call": "openUrl", "args": { "url": { "path": "/user/website" } } } } },
			{ "id": "follow-button-label", "component": "Text", "text": "Follow" },
			{ "id": "follow-button", "component": "Button", "variant": "primary", "child": "follow-button-label", "action": { "event": { "name": "follow_user", "context": { "userId": { "path": "/user/id" }, "source": "profile-card" } } } }
		] } },
		{ "version": "v0.9.1", "updateDataModel": { "surfaceId": "profile", "value": { "user": { "id": "u_42", "firstName": "Matt", "lastName": "Wordsworth", "role": "Editor · Example Magazine", "bio": "Writes about open publishing, block themes and the open web.", "avatar": "https://www.gravatar.com/avatar/00000000000000000000000000000000?d=mp&s=96", "website": "https://wordpress.org/" } } } }
	]
}
